# Скопируйте файл в .env и задайте значения. Файл .env в git не попадает.

# --- Общие ---
APP_ENV=production
TZ=Europe/Moscow                # таймзона отображения дат в UI и PDF
LOG_LEVEL=INFO
LOG_FORMAT=json                 # json | console
SECRET_KEY=change-me            # секрет; подпись JWT, задайте длинную случайную строку

# --- Админ (создаётся при первом старте, если не существует) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me        # секрет

# --- PostgreSQL ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=arxiv_digest
POSTGRES_USER=arxiv
POSTGRES_PASSWORD=change-me     # секрет

# --- RabbitMQ ---
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=arxiv
RABBITMQ_PASSWORD=change-me     # секрет

# --- LLM (OpenAI-совместимый API локальной модели) ---
LLM_BASE_URL=http://host.docker.internal:8000/v1
LLM_API_KEY=not-needed          # секрет; для локальной модели может быть заглушкой
LLM_MODEL=qwen2.5-14b-instruct
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024             # макс. токенов ответа
LLM_CONTEXT_CHARS=24000         # размер чанка входного текста в символах
LLM_TIMEOUT_SECONDS=300
LLM_CONCURRENCY=1               # параллельность очереди llm
# Доп. поля тела запроса к модели (JSON). Например, отключить «размышления» у reasoning-моделей:
#   Ollama: {"reasoning_effort":"none"}   vLLM: {"chat_template_kwargs":{"enable_thinking":false}}
LLM_EXTRA_BODY={}

# --- SMTP: только секрет (остальные параметры задаются в админке) ---
SMTP_PASSWORD=change-me

# --- arXiv ---
ARXIV_REQUEST_DELAY_SECONDS=3
ARXIV_MAX_RESULTS_PER_TOPIC=200
ARXIV_USER_AGENT=arxiv-digest/1.0 (mailto:admin@example.com)

# --- Пайплайн ---
SEND_EMPTY_DIGEST=false         # рассылать ли дайджест, в котором нет статей
PIPELINE_STALE_HOURS=6          # через сколько часов незавершённый пайплайн считается зависшим

# --- Хранилище ---
DATA_DIR=/data                  # PDF статей и дайджестов, лог-файлы
